# Public, browser-visible configuration only. Never put secrets here.
# Base URL of the backend API (no trailing slash). Example: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to serve realistic in-browser fixtures instead of calling a backend.
NEXT_PUBLIC_API_MOCK=0
# Set to 1 when the backend authenticates with an httpOnly cookie (token never exposed to JS).
NEXT_PUBLIC_AUTH_COOKIE=0
