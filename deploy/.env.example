# migration-agent platform: environment template. Copy to deploy/.env and edit.
#   cp deploy/.env.example deploy/.env
# PLACEHOLDERS ONLY. Never commit deploy/.env (it is git-ignored). Generate secrets with:
#   openssl rand -hex 32

# ---- Images / build ---------------------------------------------------------------------------
# Base images are build args. Release builds should pin by digest (python:3.12-slim@sha256:...).
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-slim
# Tag used for locally built images.
IMAGE_TAG=local

# ---- Postgres ---------------------------------------------------------------------------------
POSTGRES_DB=migration_agent
# Bootstrap SUPERUSER, used only by the postgres image to initialise the volume. The application never connects as it.
POSTGRES_USER=ma_admin
# REQUIRED. Placeholders, replace each with its own value (openssl rand -hex 32).
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
# Role that owns the schema; used ONLY by the one-shot `migrate` service.
MA_OWNER_PASSWORD=change-me-generate-with-openssl-rand-hex-32
# Role the api and worker connect as (no DDL, subject to row-level security). Roles are created on FIRST init of the
# data volume by deploy/postgres-init/10-roles.sh; changing these later needs ALTER ROLE.
MA_APP_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# ---- Backend API / worker ---------------------------------------------------------------------
# DATABASE_URL is built from the three values above by docker-compose.yml (override the compose file for an external database).
# Variable names below follow backend/app/config.py (pydantic Settings, case-insensitive).
ENVIRONMENT=production
# dev = local password auth + locally signed JWT (development only). oidc = verify external JWTs via JWKS.
AUTH_MODE=dev
# REQUIRED for AUTH_MODE=dev: HMAC key that signs dev JWTs. Must be >= 32 bytes of real randomness: the backend REFUSES
# TO START in production with this placeholder, a short value or a low-entropy value. openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Only for AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000
# Object store backend: local (volume) or s3 (skeleton upstream).
STORE_BACKEND=local
STORE_DIR=/data/objects
LOG_LEVEL=INFO
# Self-service signup. CLOSED by default (production): every account can spend model budget. Set true deliberately;
# the app default is also false when ENVIRONMENT=production (true only in dev).
SIGNUP_ENABLED=false
# Plan assigned to self-serve workspaces ("free": small numeric limits, see backend/app/billing.py). "internal" has
# very large limits and must only be assigned explicitly to a workspace by an operator.
DEFAULT_PLAN=free
MAX_WORKSPACES_PER_USER=3
# Client-IP source for rate limiting. false = TCP peer address (correct when the API is reached directly).
# true = the API is reachable ONLY through your reverse proxy, which APPENDS the real client to X-Forwarded-For;
# set TRUSTED_PROXY_COUNT to the number of such proxies. Wrong values either collapse all users into one bucket
# (false behind a proxy) or let clients spoof their IP (true when directly reachable).
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
# tmpfs for /estimate scratch in the api container: >= 3 x (MAX_UPLOAD_MB + MAX_EXTRACTED_MB).
API_SCRATCH_SIZE=2g

# ---- Source ingestion limits (SSRF and archive-bomb controls) -----------------------------------
MAX_UPLOAD_MB=100
MAX_EXTRACTED_MB=500
# Comma separated git host allowlist (e.g. github.com,gitlab.com). Enforced by the app AND by the worker's egress proxy:
# the worker clones through the proxy, which only permits these hosts (plus the model host). EMPTY = the worker cannot
# clone git sources at all (uploads still work); the api (used by /estimate) would accept any public host.
GIT_ALLOWED_HOSTS=github.com,gitlab.com

# ---- Model access (worker only) ----------------------------------------------------------------
# Provider key, passed explicitly to the engine per job. Worker container only, never api or web, never baked.
MODEL_API_KEY=
# Optional custom endpoint (gateway). Its host must equal MODEL_ENDPOINT_HOST.
MODEL_API_BASE=
# Server-side model profiles (customers choose fast|balanced|best, never raw model ids). Defaults are Gemini.
PROFILE_FAST_MODEL=gemini/gemini-2.5-flash-lite
PROFILE_BALANCED_MODEL=gemini/gemini-2.5-flash
PROFILE_BEST_MODEL=gemini/gemini-2.5-pro
# Hostname (no scheme, no port) the egress proxy allows. Must match the provider of the models above
# (generativelanguage.googleapis.com for Gemini, api.anthropic.com for Anthropic models).
MODEL_ENDPOINT_HOST=generativelanguage.googleapis.com
MA_LLM_MAX_RETRIES=
MA_LOG_LEVEL=WARNING
# Per-run default and absolute ceiling in USD.
DEFAULT_MAX_USD=5.0
HARD_MAX_USD=200.0

# ---- Worker hardening knobs ---------------------------------------------------------------------
WORKER_MEM_LIMIT=2g
WORKER_PIDS_LIMIT=256
ENGINE_WORKERS=2
JOB_MAX_ATTEMPTS=3

# ---- Web ---------------------------------------------------------------------------------------
# Public API URL as seen by the BROWSER. Baked at build time (public value, not a secret).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to serve fixtures without a backend (demo only).
NEXT_PUBLIC_API_MOCK=0

# ---- Published ports (bound to loopback by default) --------------------------------------------
API_PORT=8000
WEB_PORT=3000

# ---- Optional MinIO (compose profile "s3"); S3-compatible store for later -----------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-generate-with-openssl-rand-hex-32
S3_BUCKET=migration-agent
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
